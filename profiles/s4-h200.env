PROFILE_NAME=s4-h200-single-node
EVIDENCE_CLASS=physical-mcapi
EVIDENCE_LEVEL=physical
NODE_SELECTOR_KEY=node.cluster.x-k8s.io/nodegroup
NODE_SELECTOR_VALUE=gpu-workers
GPU_RESOURCE_NAME=nvidia.com/gpu
GPU_COUNT=8
KFP_NAMESPACE=kubeflow
WORKLOAD_NAMESPACE=ai-workflows
STORAGE_CLASS=REPLACE_WITH_S4_CSI_CLASS
S3_ENDPOINT=REPLACE_WITH_S4_S3_ENDPOINT
S3_USE_HTTPS=1
MODEL_REGISTRY_HOST=model-registry-service.kubeflow.svc.cluster.local
MODEL_REGISTRY_PORT=8080
