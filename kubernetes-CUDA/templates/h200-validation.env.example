# Copy outside the repository and replace every REPLACE_WITH value.
PROFILE_NAME=nvidia-h200-single-node
REQUESTED_EVIDENCE_LEVEL=physical-release

KUBECONFIG=REPLACE_WITH_KUBECONFIG_PATH
KFP_NAMESPACE=kubeflow
WORKLOAD_NAMESPACE=ai-workflows

NODE_SELECTOR_KEY=ai-build-tools.ricolin.dev/accelerator
NODE_SELECTOR_VALUE=nvidia-h200
GPU_RESOURCE_NAME=nvidia.com/gpu
EXPECTED_GPU_MODEL=NVIDIA H200
EXPECTED_NODE_GPU_COUNT=8

# Keep CPU-only resolution, registration, and evidence tasks off scarce GPUs.
TRAIN_GPU_COUNT=8
PILOT_GPU_COUNT=1
GENERATE_GPU_COUNT=1
EVALUATE_GPU_COUNT=1
SERVE_GPU_COUNT=1

STORAGE_CLASS=REPLACE_WITH_DURABLE_CSI_CLASS
S3_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
S3_USE_HTTPS=1
MODEL_REGISTRY_HOST=model-registry-service.kubeflow.svc.cluster.local
MODEL_REGISTRY_PORT=8080

# Accepted executions require digest references, not mutable tags.
CUDA_SMOKE_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST
PYTORCH_CUDA_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST
CUDA_WORKFLOW_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST
CUDA_TRAIN_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST
CUDA_SERVING_IMAGE=REPLACE_WITH_IMAGE_AT_SHA256_DIGEST

BASE_MODEL_REF=stabilityai/stable-diffusion-xl-base-1.0
BASE_MODEL_REVISION=REPLACE_WITH_IMMUTABLE_COMMIT
DATASET_URI=REPLACE_WITH_IMMUTABLE_DATASET_URI
DATASET_SHA256=REPLACE_WITH_SHA256
