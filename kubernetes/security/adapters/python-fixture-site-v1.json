{
  "schema_version": "1.0.0",
  "kind": "source-runtime",
  "name": "python-fixture-site-v1",
  "build": {
    "engine": "docker-buildx-oci",
    "network": "none",
    "platform": "linux/amd64",
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runtime": {
    "container_port": 8080,
    "health_path": "/healthz",
    "run_as_non_root": true,
    "read_only_root_filesystem": true,
    "allowed_paths": [
      "/",
      "/healthz",
      "/api/profile",
      "/api/admin-canary"
    ],
    "synthetic_checks": [
      {
        "id": "public-home",
        "method": "GET",
        "path": "/",
        "identity": "anonymous",
        "expected_status": 200
      },
      {
        "id": "viewer-profile",
        "method": "GET",
        "path": "/api/profile",
        "identity": "viewer-fixture",
        "authorization": "Bearer viewer-fixture",
        "expected_status": 200
      },
      {
        "id": "viewer-admin-canary",
        "method": "GET",
        "path": "/api/admin-canary",
        "identity": "viewer-fixture",
        "authorization": "Bearer viewer-fixture",
        "expected_status": 403,
        "proof_label": "PROVEN_SYNTHETIC_PRIVILEGE_BOUNDARY"
      }
    ]
  }
}
