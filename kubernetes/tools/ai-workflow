#!/usr/bin/env bash
set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
workflow_root="${root_dir}/kubernetes/workflows"
if [[ -n ${UV_BIN:-} ]]; then
  uv_bin=${UV_BIN}
elif command -v uv >/dev/null 2>&1; then
  uv_bin=uv
else
  uv_bin=/opt/ai-build-tools-bin/uv
fi

command -v "${uv_bin}" >/dev/null 2>&1 || {
  echo "BLOCKED: uv is required; run kubernetes/tools/install-uv.sh and export UV_BIN" >&2
  exit 1
}

cd "${workflow_root}"

show_help() {
  cat <<'EOF'
usage: ai-workflow {capabilities|agent|model|image|image-pipeline|research|code-review|code-review-pipeline|code-agent|code-sandbox|RESEARCH_COMMAND} ...

Command groups:
  capabilities       Print implemented contract capabilities.
  agent              Validate a released adviser and a grounded typed plan.
  model              Validate datasets/releases and render training/serving.
  image              Validate image prompts and render CUDA workloads.
  image-pipeline     Compile or submit the KFP-owned image A/B/gallery pipeline.
  research           Lock source/runtime evidence and render private reports.
  code-review        Validate code-review data/releases and render training/serving.
  code-review-pipeline Compile or submit the KFP-owned code-review A/B/C pipeline.
  code-agent         Generate and validate grounded review, fix, and test plans.
  code-sandbox       Render isolated fetch, patch, unit-test, and patch-export Jobs.
  RESEARCH_COMMAND   Compatibility shortcut for a research subcommand.

Run "ai-workflow <group> --help" for group-specific commands.
EOF
}

command_name=${1:-}
case "${command_name}" in
  -h|--help)
    show_help
    ;;
  capabilities)
    "${uv_bin}" run --frozen ai-security-research capabilities
    printf '%s\n' \
      security-adviser-client-v1 \
      security-agent-plan-policy-v1 \
      security-model-dataset-contract-v1 \
      security-model-training-job-v1 \
      security-model-kserve-vllm-v1 \
      code-review-model-abc-v1 \
      code-review-agent-patch-v1 \
      code-review-sandbox-v1 \
      kfp-trainer-kueue-code-review-v1 \
      kfp-trainer-kueue-image-v1 \
      reserved-serving-capacity-v1 \
      promotion-lifecycle-v1
    ;;
  agent)
    shift
    exec "${uv_bin}" run --frozen ai-security-agent "$@"
    ;;
  model)
    shift
    exec "${uv_bin}" run --frozen ai-security-model "$@"
    ;;
  image)
    shift
    exec "${uv_bin}" run --frozen ai-image-model "$@"
    ;;
  image-pipeline)
    shift
    exec "${uv_bin}" run --frozen ai-image-pipeline "$@"
    ;;
  research)
    shift
    exec "${uv_bin}" run --frozen ai-security-research "$@"
    ;;
  code-review)
    shift
    exec "${uv_bin}" run --frozen ai-code-review-model "$@"
    ;;
  code-review-pipeline)
    shift
    exec "${uv_bin}" run --frozen ai-code-review-pipeline "$@"
    ;;
  code-agent)
    shift
    exec "${uv_bin}" run --frozen ai-code-review-agent "$@"
    ;;
  code-sandbox)
    shift
    exec "${uv_bin}" run --frozen ai-code-review-sandbox "$@"
    ;;
  "")
    show_help >&2
    exit 2
    ;;
  *)
    # Keep the original analysis-only commands directly addressable for the
    # command-first research runbooks.
    exec "${uv_bin}" run --frozen ai-security-research "$@"
    ;;
esac
