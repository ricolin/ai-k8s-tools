PROFILE_NAME=nvidia-h200-single-node
EVIDENCE_CLASS=physical-kubernetes
# This profile is a requested configuration, not observed physical evidence.
# The CUDA validation runner must promote the evidence level only after its
# physical gates pass.
EVIDENCE_LEVEL=candidate
NODE_SELECTOR_KEY=ai-build-tools.ricolin.dev/accelerator
NODE_SELECTOR_VALUE=nvidia-h200
GPU_RESOURCE_NAME=nvidia.com/gpu
EXPECTED_NODE_GPU_COUNT=8
PILOT_GPU_COUNT=1
TRAIN_GPU_COUNT=8
GENERATE_GPU_COUNT=1
EVALUATE_GPU_COUNT=1
SERVE_GPU_COUNT=1
KFP_NAMESPACE=kubeflow
WORKLOAD_NAMESPACE=ai-workflows
# Replace these values in a site-owned profile before installation.
STORAGE_CLASS=REPLACE_WITH_DURABLE_CSI_CLASS
S3_ENDPOINT=REPLACE_WITH_S3_ENDPOINT
S3_USE_HTTPS=1
MODEL_REGISTRY_HOST=model-registry-service.kubeflow.svc.cluster.local
MODEL_REGISTRY_PORT=8080
