#!/usr/bin/env bash
set -euo pipefail

root_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
workflow_root="${root_dir}/kubernetes/workflows"
uv_bin=${UV_BIN:-uv}

command -v "${uv_bin}" >/dev/null 2>&1 || {
  echo "BLOCKED: uv is required" >&2
  exit 1
}

cd "${workflow_root}"

show_help() {
  cat <<'EOF'
usage: ai-workflow {capabilities|agent|model|image|research|RESEARCH_COMMAND} ...

Command groups:
  capabilities       Print implemented contract capabilities.
  agent              Validate a released adviser and a grounded typed plan.
  model              Validate datasets/releases and render training/serving.
  image              Validate image prompts and render CUDA Jobs.
  research           Lock source/runtime evidence and render private reports.
  RESEARCH_COMMAND   Compatibility shortcut for a research subcommand.

Run "ai-workflow <group> --help" for group-specific commands.
EOF
}

command_name=${1:-}
case "${command_name}" in
  -h|--help)
    show_help
    ;;
  capabilities)
    "${uv_bin}" run --frozen ai-security-research capabilities
    printf '%s\n' \
      security-adviser-client-v1 \
      security-agent-plan-policy-v1 \
      security-model-dataset-contract-v1 \
      security-model-training-job-v1 \
      security-model-kserve-vllm-v1
    ;;
  agent)
    shift
    exec "${uv_bin}" run --frozen ai-security-agent "$@"
    ;;
  model)
    shift
    exec "${uv_bin}" run --frozen ai-security-model "$@"
    ;;
  image)
    shift
    exec "${uv_bin}" run --frozen ai-image-model "$@"
    ;;
  research)
    shift
    exec "${uv_bin}" run --frozen ai-security-research "$@"
    ;;
  "")
    show_help >&2
    exit 2
    ;;
  *)
    # Keep the original analysis-only commands directly addressable for the
    # command-first research runbooks.
    exec "${uv_bin}" run --frozen ai-security-research "$@"
    ;;
esac
