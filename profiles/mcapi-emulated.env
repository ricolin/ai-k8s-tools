PROFILE_NAME=mcapi-emulated
EVIDENCE_CLASS=emulated-mcapi
EVIDENCE_LEVEL=mechanics
NODE_SELECTOR_KEY=node.cluster.x-k8s.io/nodegroup
NODE_SELECTOR_VALUE=gpu-workers
GPU_RESOURCE_NAME=
GPU_COUNT=0
KFP_NAMESPACE=kubeflow
WORKLOAD_NAMESPACE=ai-workflows
STORAGE_CLASS=local-path
S3_ENDPOINT=seaweedfs.kubeflow.svc.cluster.local:9000
S3_USE_HTTPS=0
MODEL_REGISTRY_HOST=model-registry-service.kubeflow.svc.cluster.local
MODEL_REGISTRY_PORT=8080
# Site-owned management network and registry identities are never committed.
MCAPI_NODE_CIDR=${MCAPI_NODE_CIDR:-}
MCAPI_NODE_GATEWAY=${MCAPI_NODE_GATEWAY:-}
MCAPI_EXTERNAL_INTERFACE=${MCAPI_EXTERNAL_INTERFACE:-}
MCAPI_NODE_SSH_USER=${MCAPI_NODE_SSH_USER:-ubuntu}
MCAPI_NODE_SSH_KEY=${MCAPI_NODE_SSH_KEY:-}
HOST_KUBECONFIG=${HOST_KUBECONFIG:-}
REGISTRY_HOST=${REGISTRY_HOST:-}
REGISTRY_NAMESPACE=${REGISTRY_NAMESPACE:-ai-release-registry}
REGISTRY_ROUTE_MANIFEST=${REGISTRY_ROUTE_MANIFEST:-}
